    <script>
        // Função para copiar o texto para a área de transferência
        function copyToClipboard(elementId, button) {
            // Obtém os códigos das cores do elemento span oculto
            const colorCodes = document.getElementById(elementId).innerText;
            // Adiciona o texto introdutório
            const textToCopy = "Utilize a seguinte paleta de cores: " + colorCodes;
            
            // Cria um elemento de input temporário para usar o execCommand
            const tempInput = document.createElement('textarea');
            tempInput.style.position = 'absolute';
            tempInput.style.left = '-9999px';
            tempInput.value = textToCopy;
            document.body.appendChild(tempInput);
            tempInput.select();
            
            try {
                // Tenta copiar o texto
                document.execCommand('copy');
                
                // Fornece feedback visual ao usuário
                const originalText = button.innerText;
                button.innerText = 'Copiado!';
                button.classList.add('bg-green-600', 'hover:bg-green-700');
                button.classList.remove('bg-blue-600', 'hover:bg-blue-700');

                // Volta ao texto original após 2 segundos
                setTimeout(() => {
                    button.innerText = originalText;
                    button.classList.remove('bg-green-600', 'hover:bg-green-700');
                    button.classList.add('bg-blue-600', 'hover:bg-blue-700');
                }, 2000);

            } catch (err) {
                // Log de erro caso a cópia falhe
                console.error('Falha ao copiar texto: ', err);
                // Fallback para o usuário caso execCommand não funcione
                alert('Não foi possível copiar as cores automaticamente. Por favor, tente manualmente.');
            } finally {
                // Remove o elemento de input temporário
                document.body.removeChild(tempInput);
            }
        }
    </script>
